# multitask/builders/i2b2_2010.py's docstring for the expected layout (train
# from concept_assertion_relation_training_data.tar.gz, test from
# reference_standard_for_test_data.tar.gz + test_data.tar.gz).
raw_datasets/2010i2b2/*
!raw_datasets/2010i2b2/*.pdf

