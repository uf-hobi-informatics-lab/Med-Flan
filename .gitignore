# --- Housekeeping ---
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Editor config — contains sftp.json with host/port/password, must not be committed
.vscode/

# Claude Code internal runtime state (not project content)
.claude/scheduled_tasks.lock

# Scratch/working dirs. .scratch_shac/ is an unzipped copy of the SHAC
# annotation-guidelines .docx (used to ground the sdoh_event instruction
# text) -- that document is DUA-gated and its tracked copies under
# 2022n2c2_track2/Track2_SubtaskA/ are deliberately being removed from
# version control, so an unignored extraction of it must not be committed
# either.
.scratch*/

